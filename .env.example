# Local development values only. Copy to .env and replace the password.
POSTGRES_DB=musicflow
POSTGRES_USER=musicflow
POSTGRES_PASSWORD=replace-with-a-random-local-password

MUSICFLOW_API_PORT=8000
MUSICFLOW_ENVIRONMENT=development
MUSICFLOW_LOG_LEVEL=INFO
MUSICFLOW_DB_CONNECT_TIMEOUT_SECONDS=3
MUSICFLOW_WORKER_HEARTBEAT_SECONDS=5
MUSICFLOW_OIDC_ISSUER=https://auth.kontora-pos.store/realms/musicflow
MUSICFLOW_OIDC_AUDIENCE=musicflow-api
MUSICFLOW_OIDC_JWKS_URL=http://keycloak-gateway:8080/realms/musicflow/protocol/openid-connect/certs
MUSICFLOW_OIDC_JWKS_CACHE_SECONDS=300
MUSICFLOW_OIDC_CLOCK_SKEW_SECONDS=30
MUSICFLOW_RATE_LIMIT_ENABLED=true
MUSICFLOW_RATE_LIMIT_WINDOW_SECONDS=60
MUSICFLOW_RATE_LIMIT_ORIGIN_REQUESTS=120
MUSICFLOW_RATE_LIMIT_IDENTITY_REQUESTS=60
MUSICFLOW_RATE_LIMIT_MAX_KEYS=10000
MUSICFLOW_TRUST_CLOUDFLARE_CONNECTING_IP=true

# Public, non-secret Keycloak settings. Passwords live in ignored files under .secrets/.
KEYCLOAK_HOSTNAME_URL=https://auth.kontora-pos.store
KEYCLOAK_ADMIN_PORT=8081
KEYCLOAK_GATEWAY_PORT=8082
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KEYCLOAK_PROXY_SUBNET=172.30.53.0/29
